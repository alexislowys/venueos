# Copy to .env.local (gitignored). Values live in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional — demo deployment only. Shows the "View demo (one click)" button and
# signs visitors in with this account. Never set these on a production instance.
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=

# Optional — sidebar name (defaults to "My Bar").
# VITE_BUSINESS_NAME=
